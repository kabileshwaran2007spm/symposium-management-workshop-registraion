# CampusConnect frontend environment.
# Copy to .env.local and adjust if your backend runs elsewhere.

# REST base URL the browser talks to.
# For Vercel, set this to
# https://symposium-management-workshop-registraion.onrender.com/api
VITE_API_BASE_URL=http://localhost:8080/api

# Google OAuth web client ID. Configure the matching authorized origins in
# Google Cloud Console. The value is public and is safe to expose in the frontend.
VITE_GOOGLE_CLIENT_ID=
