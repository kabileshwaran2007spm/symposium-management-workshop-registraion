# CampusConnect backend environment variable reference.
# Spring Boot does not load .env files automatically. Set these variables in
# the PowerShell session that starts the backend.

# MongoDB connection.
MONGODB_URI=mongodb://127.0.0.1:27017/campusconnect

# JWT signing secret. Generate locally; never commit a real value.
# PowerShell: $bytes = New-Object byte[] 48
# $rng = [System.Security.Cryptography.RandomNumberGenerator]::Create()
# $rng.GetBytes($bytes)
# $env:JWT_SECRET = [Convert]::ToBase64String($bytes)

# Seeding is opt-in and only runs when the database has no users.
APP_SEED_ENABLED=false
# When seeding is enabled, set APP_SEED_PASSWORD to a private value of 8+ chars.

# Comma-separated origins allowed by CORS.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://symposium-management-workshop-registraion-lol3-94n7acls4.vercel.app

# Local server port. Render provides PORT automatically; do not hardcode it there.
SERVER_PORT=8080
