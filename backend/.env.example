# CampusConnect backend environment.
# Copy to .env (or set in your shell) before running the jar.

# MongoDB connection. NOTE: the property is `spring.mongodb.uri`.
SPRING_MONGODB_URI=mongodb://localhost:27017/campusconnect

# JWT signing. Use a long random value in any real deployment.
JWT_SECRET=change-me-to-a-long-random-secret-at-least-32-chars

# Seeding: creates demo accounts on first boot when no users exist.
APP_SEED_ENABLED=true
APP_SEED_PASSWORD=Campus@123

# Comma-separated origins allowed by CORS.
APP_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Server port.
SERVER_PORT=8080
