@echo off
REM Stop only verified CampusConnect listeners; leave MongoDB and unrelated processes running.
powershell -NoProfile -Command "$root=[IO.Path]::GetFullPath('%~dp0..'); $front=Join-Path $root 'frontend'; $back=Join-Path $root 'backend'; foreach($port in @(5173,8080)){ $listener=Get-NetTCPConnection -LocalPort $port -State Listen -ErrorAction SilentlyContinue | Select-Object -First 1; if(-not $listener){ Write-Host ('Nothing is listening on port ' + $port); continue }; $process=Get-CimInstance Win32_Process -Filter ('ProcessId = ' + $listener.OwningProcess); $parent=Get-CimInstance Win32_Process -Filter ('ProcessId = ' + $process.ParentProcessId); if($port -eq 5173){ $safe=$process.Name -eq 'node.exe' -and $process.CommandLine -match [regex]::Escape($front) -and $process.CommandLine -match 'vite[.]js' } else { $safe=$process.Name -eq 'java.exe' -and $process.CommandLine -match 'com[.]campusconnect[.]CampusconnectApplication' -and $parent.Name -eq 'java.exe' -and $parent.CommandLine -match [regex]::Escape($back) -and $parent.CommandLine -match 'spring-boot:run' }; if(-not $safe){ Write-Warning ('Refusing to stop unverified listener PID ' + $process.ProcessId + ' on port ' + $port); continue }; Stop-Process -Id $process.ProcessId -Force; if($port -eq 8080 -and (Get-Process -Id $parent.ProcessId -ErrorAction SilentlyContinue)){ Stop-Process -Id $parent.ProcessId -Force }; Write-Host ('Stopped verified CampusConnect process on port ' + $port) }; Write-Host 'MongoDB was left running.'"
if errorlevel 1 exit /b 1
echo MongoDB is intentionally left running to preserve database availability.